{
  "name": "wyrm-obsidian",
  "version": "0.1.0",
  "description": "Wyrm threat-modeling plugin for Obsidian",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "typecheck": "npm run wasm && tsc --noEmit",
    "build": "npm run wasm && tsc --noEmit && node esbuild.config.mjs production",
    "dev": "npm run wasm && node esbuild.config.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22",
    "builtin-modules": "^4",
    "esbuild": "^0.24",
    "obsidian": "^1.7.2",
    "tslib": "^2.8",
    "typescript": "^5.6"
  }
}
