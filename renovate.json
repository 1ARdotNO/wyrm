{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "automerge": true,
  "platformAutomerge": true,
  "major": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the tree-sitter grammar commit pinned by the Zed extension.",
      "fileMatch": ["^editors/zed/extension\\.toml$"],
      "matchStrings": [
        "repository\\s*=\\s*\"https://github\\.com/(?<depName>[^\"]+)\"\\s*[\\r\\n]+\\s*commit\\s*=\\s*\"(?<currentDigest>[a-f0-9]+)\""
      ],
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Track the Mermaid version loaded from the jsDelivr CDN in the docs.",
      "fileMatch": ["^docs/.+\\.html$"],
      "matchStrings": ["cdn\\.jsdelivr\\.net/npm/mermaid@(?<currentValue>[0-9.]+)/"],
      "depNameTemplate": "mermaid",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Heavy automerge for everything — the CI suite (fmt + clippy -Dwarnings + tests + cargo-deny + CodeQL + Trivy) is the safety net, so anything that stays green merges itself.",
      "matchManagers": ["cargo", "github-actions"],
      "automerge": true
    },
    {
      "description": "Group all GitHub Actions bumps into one PR.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Automerge the custom-managed grammar/CDN bumps too.",
      "matchManagers": ["custom.regex"],
      "automerge": true
    }
  ]
}
